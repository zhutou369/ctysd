    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.6; color: #222; margin: 0; background: #fff; }
        .wrapper { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
        
        /* 🎯 优化内页公共页头样式 */
        header { border-bottom: 1px solid #eee; padding-bottom: 20px; margin-bottom: 30px; }
        .header-logo { text-decoration: none; color: #000; font-weight: 800; font-size: 20px; display: inline-block; }
        
        h1 { font-size: 32px; margin-bottom: 15px; color: #111; line-height: 1.3; }
        .breadcrumb-nav { font-size: 14px; color: #666; margin-bottom: 30px; padding-bottom: 10px; }
        .breadcrumb-nav a { color: #0066cc; text-decoration: none; }
        .breadcrumb-nav a:hover { text-decoration: underline; }
        
        /* 文章正文样式 */
        .content { font-size: 16px; color: #333; line-height: 1.8; }
        .content h2 { font-size: 22px; margin-top: 35px; margin-bottom: 15px; color: #111; border-bottom: 1px solid #f0f0f0; padding-bottom: 5px; }
        .content h3 { font-size: 18px; margin-top: 25px; margin-bottom: 12px; color: #222; }
        .content p { margin-bottom: 20px; text-align: justify; }
        .content ul, .content ol { padding-left: 20px; margin-bottom: 20px; }
        .content li { margin-bottom: 8px; }
        .content img { max-width: 100%; height: auto; display: block; margin: 25px auto; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        
        /* 🎯 上一篇下一篇结构化导航样式 */
        .post-nav { display: flex; justify-content: space-between; margin: 40px 0; padding: 20px 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; font-size: 15px; gap: 20px; }
        .post-nav div { flex: 1; }
        .post-nav .nav-next { text-align: right; }
        .post-nav a { color: #0066cc; text-decoration: none; font-weight: 500; }
        .post-nav a:hover { text-decoration: underline; }
        
        /* 页脚与友情链接 */
        .footer { margin-top: 60px; padding-top: 20px; border-top: 1px solid #eee; font-size: 14px; color: #666; }
        .friend-links { margin-bottom: 20px; }
        .friend-links a { color: #555; text-decoration: none; margin-right: 15px; display: inline-block; }
        .friend-links a:hover { color: #0066cc; text-decoration: underline; }
        .copyright { color: #999; font-size: 13px; }
    </style>
    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
    <script>LA.init({id:"3K7l95Zodr0uFrIN",ck:"3K7l95Zodr0uFrIN"})</script>
</head>
<body>
    
    {%- set prevPost = collections.posts | getPreviousCollectionItem(page) %}
    {%- set nextPost = collections.posts | getNextCollectionItem(page) %}

    <div class="wrapper">
        <header><a href="/" class="header-logo">QHSDK 通讯中心</a></header>
        
        <article>
            <h1>{{ title }}</h1>
            
            <div class="breadcrumb-nav">
                当前位置：<a href="/">首页入口</a> &gt; <a href="/blog/">文章列表页</a> &gt; 正文内容
            </div>

            <div class="content">
                {{ content | safe }}
            </div>
        </article>

        <nav class="post-nav">
            <div class="nav-prev">
                {% if prevPost %}<a href="{{ prevPost.url }}">← {{ prevPost.data.title }}</a>{% endif %}
            </div>
            <div class="nav-next">
                 {% if nextPost %}<a href="{{ nextPost.url }}">{{ nextPost.data.title }} →</a>{% endif %}
            </div>
        </nav>

        <footer class="footer">
            <div class="friend-links">
                <strong>推荐资源：</strong>
